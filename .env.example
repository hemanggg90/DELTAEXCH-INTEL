# Copy to .env (gitignored). Safe defaults: PAPER mode, TESTNET, local SQLite.

# TESTNET | PRODUCTION. API keys are per environment.
DELTA_ENV=TESTNET
DELTA_API_KEY=
DELTA_API_SECRET=
# Optional override of the REST base URL
# DELTA_BASE_URL=

# PAPER | LIVE. Live orders also need TRADING_LIVE_CONFIRM=YES_I_UNDERSTAND_THE_RISK
TRADING_MODE=PAPER
TRADING_LIVE_CONFIRM=

# Password gate for the dashboard
APP_PASSWORD=
# true enables the sidebar credentials panel (session only, never written to disk)
APP_PRIVATE=false

# Default: SQLite in data_cache/. Hosted example: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=

# Display-only USD->INR conversion, shown as an estimate (88.0 when unset; set the current rate)
USDINR_RATE=

# Fee model. Defaults are the PRODUCTION schedule (0.01% of notional, capped at 3.5% of premium).
# Delta's TESTNET charges more (0.03%, capped at 10%). To mirror testnet in a test run, uncomment:
# FALLBACK_TAKER_RATE=0.0003
# FALLBACK_MAKER_RATE=0.0003
# FALLBACK_PREMIUM_CAP_RATE=0.1
